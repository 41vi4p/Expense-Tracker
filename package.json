    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.119.0",
    "chart.js": "^4.5.0",
    "date-fns": "^4.1.0",
    "firebase": "^12.19.0",
    "framer-motion": "^12.23.3",
    "lucide-react": "^0.525.0",
    "next": "^16.4.5",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.2",
    "recharts": "^3.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
